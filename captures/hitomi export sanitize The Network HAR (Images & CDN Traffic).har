               hash = hash.replace(\"#\",\"\");\n                var re = /^(\\d+)-\\d*$/;\n                var ok = re.exec(hash);\n                if (ok && ok[1] <= our_galleryinfo.length && ok[1] > 0) {\n                        curPanel = ok[1];\n                        fullSpread();\n                } else if (!isNaN(hash) && hash <= our_galleryinfo.length && hash > 0) {\n                        curPanel = hash;\n                        if (Cookies && spread_pref && spread_pref == 'full_spread') {\n                                fullSpread();\n                        } else {\n                                singleSpread();\n                        }\n                } else {\n                        fullSpread();\n                }\n        } else if (Cookies && spread_pref == 'single_page') {\n            singleSpread();\n        } else if (portrait) {\n            singleSpread();\n        } else {        \n            fullSpread();\n        }\n\n        if (curPanel == 1) {\n                disable($(\"#prevPanel\"));\n        }\n        if (curPanel >= our_galleryinfo.length) {\n                disable($(\"#nextPanel\"));\n        }\n        vate($('#prevScene'), !at_first_scene());\n        vate($('#nextScene'), !at_last_scene());\n}\n\nfunction mobile_hashChanged() {\n        var hash = window.location.hash;\n        \n        if (hash) {\n                hash = hash.replace(\"#\",\"\");\n                var re = /^(\\d+)-\\d*$/;\n                var ok = re.exec(hash);\n                if (ok && ok[1] <= our_galleryinfo.length && ok[1] > 0) {\n                        curPanel = ok[1];\n                        mobile_fullSpread();\n                } else if (!isNaN(hash) && hash <= our_galleryinfo.length && hash > 0) {\n                        curPanel = hash;\n                        mobile_singleSpread();\n                } else {\n                        mobile_fullSpread();\n                }\n        } else {\n                mobile_singleSpread();\n        }\n\n        if (curPanel == 1) {\n                mobile_disable($(\"#mobile-prevPanel\"));\n        }\n        if (curPanel >= our_galleryinfo.length) {\n                mobile_disable($(\"#mobile-nextPanel\"));\n        }\n        mobile_vate($('#mobile-prevScene'), !at_first_scene());\n        mobile_vate($('#mobile-nextScene'), !at_last_scene());\n}\n\nfunction init() {\n        var result = window.location.href.match(/\\/reader\\/([0-9]+)\\.html/);\n        if (!result[1]) return;\n        \n        var galleryid = result[1];\n        \n        $.ajaxSetup({\n                cache: true\n        });\n        \n        $.getScript('//'+domain+'/galleries/'+galleryid+'.js', function() {\n                our_galleryinfo = galleryinfo['files'].slice(0);\n                \n                $.ajax({ url: '//master.hitomi.la/pc/'+galleryinfo['id'] });\n\n                if (galleryinfo['language'] === 'japanese' && galleryinfo['japanese_title']) {\n                        document.title = galleryinfo['japanese_title']+' '+document.title;\n                } else {\n                        document.title = galleryinfo['title']+' '+document.title;\n                }\n                \n                $('.brand').each(function(i, el) {\n                        if (galleryinfo['galleryurl']) {\n                                el.href = galleryinfo['galleryurl'];\n                        } else {\n                                el.href = '../galleries/'+galleryinfo['id']+'.html';\n                        }\n                });\n\n                if (is_mobile) {\n                        mobile_init();\n                } else {\n                        desktop_init();\n                }\n        });\n}\n\nfunction desktop_init() {\n        $(\".navbar\").removeClass(\"hidden\");\n        $(\"#comicImages\").removeClass(\"hidden\");\n        $(\"body\").css(\"overflow\", \"hidden\");\n\n        createDropdown(1);\n        createDropdown(2);\n    \n        $('#fullSpread').hide();\n        $('#offsetPage').hide();\n        $('#singlePage').hide();\n\n        $(\"#prevPanel\").on(\"click\", prevPanel);\n        $(document).bind('keydown', 'right', prevPanel);\n        $(document).bind('keydown', 'k', prevPanel);\n\n        $(\"#prevScene\").on(\"click\", prev_scene);\n        $(document).bind('keydown', 'm', prev_scene);\n\n        $(\"#nextPanel\").on(\"click\", nextPanel);\n        $(document).bind('keydown', 'left', nextPanel);\n        $(document).bind('keydown', 'j', nextPanel);\n        \n        $(\"#nextScene\").on(\"click\", next_scene);\n        $(document).bind('keydown', 'n', next_scene);\n        document.addEventListener(\"keydown\", (e) => {\n                if (e.code === 'BracketLeft') {\n                        return next_scene();\n                } else if (e.code === 'BracketRight') {\n                        return prev_scene();\n                }\n        });\n\n        $(\"#fitVertical\").on(\"click\", fitVertical);\n        $(document).bind('keydown', 'v', fitVertical);\n\n        $(\"#fitHorizontal\").on(\"click\", fitHorizontal);\n        $(document).bind('keydown', 'h', fitHorizontal);\n    \n        $(\"#fullscreen\").on(\"click\", fullscreen);\n\n        $(\"#fullSpread\").on(\"click\", fullSpread);\n        $(document).bind('keydown', 'f', fullSpread);\n\n        $(\"#singlePage\").on(\"click\", singleSpread);\n        $(document).bind('keydown', 's', singleSpread);\n    \n        $(\"#offsetPage\").on(\"click\", offset_page);\n        $(document).bind('keydown', '2', offset_page);\n    \n        $(document).bind('keydown', 'w', function() {\n                show_original = !show_original;\n                hashChanged();\n        });\n    \n        $(document).bind('keydown', 'a', function() {\n                adapose_enabled = !adapose_enabled;\n        });\n    \n        window.onhashchange = hashChanged;\n\n        hashChanged();\n\n        var fit_pref = Cookies.get(galleryinfo['type']);\n        if (Cookies && fit_pref == 'fit_horizontal') {\n            fitHorizontal();\n        } else {\n            fitVertical();\n        }\n\n        var docElm = document.documentElement;\n        if (!docElm.requestFullscreen && !docElm.mozRequestFullScreen && !docElm.webkitRequestFullScreen && !docElm.msRequestFullscreen) {\n                $(\"#fullscreen\").parent().hide();\n        }\n}\n\nfunction mobile_init() {\n        $(\".mobile-navbar\").removeClass(\"hidden\");\n        $(\"#mobileImages\").removeClass(\"hidden\");\n        \n        mobile_createDropdowns();\n    \n        $(\"#mobile-prevPanel\").on(\"click\",  mobile_prevPanel);\n        $(\"#mobile-nextPanel\").on(\"click\",  mobile_nextPanel);\n        $(\"#mobile-fullSpread\").on(\"click\", mobile_fullSpread);\n        $(\"#mobile-offsetPage\").on(\"click\", mobile_offset_page);\n        $(\"#mobile-singlePage\").on(\"click\", mobile_singleSpread);\n        $(\"#mobile-prevScene\").on(\"click\", prev_scene);\n        $(\"#mobile-nextScene\").on(\"click\", next_scene);\n        \n        window.onhashchange = mobile_hashChanged;\n        \n        mobile_hashChanged();\n        \n        var fit_pref = Cookies.get(galleryinfo['type']);\n        if (Cookies && fit_pref == 'fit_vertical') {\n            mobile_fitVertical();\n        } else {\n            mobile_fitHorizontal();\n        }\n        \n        $(window).resize(function(){\n            if (fit_vertical) {\n                page_height = window.innerHeight - 41;\n                $(\"#mobileImages\").height(page_height);\n                \n                $(\"body\").css(\"overflow\", \"auto\");\n                $(window).scrollTop(0);\n                $(\"body\").css(\"overflow\", \"hidden\");                \n            }\n            \n            if (display == 2) {\n                if ($(\"#mobile-offsetPage\").parent().hasClass('hidden') && get_toolbar_remaining_space() > paging_dropdown_collapsed_width + 2*mobile_button_width) {\n                        $(\"#mobile-offsetPage\").parent().removeClass('hidden'); global_number_of_reader_buttons++;\n                } else if (!$(\"#mobile-offsetPage\").parent().hasClass('hidden') && get_toolbar_remaining_space() <= paging_dropdown_collapsed_width) {\n                        $(\"#mobile-offsetPage\").parent().addClass('hidden'); global_number_of_reader_buttons--;\n                }\n            }\n            if (display == 1 && galleryinfo['type'] === 'gamecg') {\n                if ($(\"#mobile-prevScene\").parent().hasClass('hidden') && get_toolbar_remaining_space() > paging_dropdown_collapsed_width + 3*mobile_button_width) {\n                        $(\"#mobile-prevScene\").parent().removeClass('hidden'); global_number_of_reader_buttons++;\n                        $(\"#mobile-nextScene\").parent().removeClass('hidden'); global_number_of_reader_buttons++;\n                } else if (!$(\"#mobile-prevScene\").parent().hasClass('hidden') && get_toolbar_remaining_space() <= paging_dropdown_collapsed_width) {\n                        $(\"#mobile-prevScene\").parent().addClass('hidden'); global_number_of_reader_buttons--;\n                        $(\"#mobile-nextScene\").parent().addClass('hidden'); global_number_of_reader_buttons--;\n                }\n            }\n            \n            const remaining_space = get_toolbar_remaining_space();\n            set_single_page_dropdown_width();\n            set_two_page_dropdown_width();\n        });\n        \n        document.addEventListener('gesturestart', function(e) {\n            gesture_start_zoom = document.documentElement.clientWidth / window.innerWidth;\n        });\n\n        document.addEventListener('gestureend', function(e) {\n            if (e.scale < 1 && gesture_start_zoom <= 1 && !fit_vertical) {\n                mobile_fitVertical();\n            } else if (e.scale > 1 && fit_vertical) {\n                mobile_fitHorizontal();\n            }\n        });\n\n        document.addEventListener('touchstart', function(e) {\n            var touch = event.targetTouches[0];\n            var w = $(window).width();\n            startX = touch.pageX;\n            startY = touch.pageY;\n    \n            if ((startX < w/10 || startX > 9*w/10) ||\n                (document.documentElement.clientWidth / window.innerWidth > 1) ||\n                (display == 2)) {\n        \n                no_swipe = true;           \n            } else {\n                no_swipe = false;\n            }\n        });\n\n        document.addEventListener('touchmove', function(e) {\n            if (no_swipe) return;\n\n            var touch = event.targetTouches[0];\n    \n            if (!checked_vertical) {\n                if (Math.abs(touch.pageX - startX) < Math.abs(touch.pageY - startY)) {\n                    no_swipe = true;\n                    return;\n                } else {\n                    checked_vertical = true;\n                }\n            }\n\n            e.preventDefault();\n            $('#mobileImages img').css(\"object-position\", touch.pageX - startX + \"px\");\n        });\n\n        document.addEventListener('touchend', function(e) {\n            if (no_swipe) return;\n    \n            checked_vertical = false;\n\n            var threshold = $(window).width()/5;\n            var object_x = $('#mobileImages img').first().css(\"object-position\").split(\"px\")[0];\n            var w = $(window).width() + 100;\n            if (object_x < -threshold && curPanel > 1) {               \n                $( \"#mobileImages img\").animate({\n                    objectPosition: -w + 'px',\n                  }, 100, function() {\n                    // Animation complete.\n                    //$('#mobileImages').empty();\n                    $('#mobileImages img').addClass('hidden'); //avoid the current page reappearing\n                    mobile_prevPanel();\n                  });\n            } else if (object_x > threshold && curPanel < our_galleryinfo.length) {\n                $( \"#mobileImages img\").animate({\n                    objectPosition: w + 'px',\n                  }, 100, function() {\n                    // Animation complete.\n                    //$('#mobileImages').empty();\n                    $('#mobileImages img').addClass('hidden'); //avoid the current page reappearing\n                    mobile_nextPanel();\n                 });\n            } else {\n                $('#mobileImages img').css(\"object-position\", 0);\n            }\n        });\n}\n\nfunction createDropdown(n) {\n    switch(n) {\n        case 1:\n                $(\"#single-page-select\").empty();\n            for (i=1; i <= our_galleryinfo.length; i++) {\n                var option = $( '<option>', {\n                    html: \"Page \" + i,\n                    value: i\n                });\n                $(\"#single-page-select\").append(option);\n            }\n            break;\n        case 2:\n                $(\"#two-page-select\").empty();\n            var i = 1;\n            while (i <= our_galleryinfo.length) {\n                var htm;\n                var val;\n                if (i == 1 || \n                        i >= our_galleryinfo.length || \n                        (our_galleryinfo[i] && our_galleryinfo[i].width > our_galleryinfo[i].height) || \n                        (our_galleryinfo[i-1] && our_galleryinfo[i-1].width > our_galleryinfo[i-1].height) ||\n                        (our_galleryinfo[i-1] && our_galleryinfo[i-1]['single'])\n                        ) {\n                    htm = \"Page \" + i;\n                    val = i + \"-\";\n                    i += 1;\n                } else {\n                    htm = \"Pages \" + i + \"-\" + (i+1);\n                    val = i + \"-\" + (i+1);\n                    i += 2;\n                    numThin += 2;\n                }\n                \n                var option = $( '<option>', {\n                    html: htm,\n                    value: val\n                });\n                $(\"#two-page-select\").append(option);\n            }\n            \n            if (numThin / our_galleryinfo.length < 0.1) {\n                portrait = true;\n            }\n            \n            break;\n    }\n}\n\nfunction mobile_createDropdowns() {\n    $(\"#mobile-single-page-select\").empty();\n    for (i=1; i <= our_galleryinfo.length; i++) {\n        var option = $( '<option>', {\n            html:  i,\n            value: i\n        });\n        $(\"#mobile-single-page-select\").append(option);\n    }\n    $(\"#mobile-two-page-select\").empty();\n    var i = 1;\n    while (i <= our_galleryinfo.length) {\n        var htm;\n        var val;\n        if (i == 1 || \n                i >= our_galleryinfo.length || \n                (our_galleryinfo[i] && our_galleryinfo[i].width > our_galleryinfo[i].height) || \n                (our_galleryinfo[i-1] && our_galleryinfo[i-1].width > our_galleryinfo[i-1].height) || \n                (our_galleryinfo[i-1] && our_galleryinfo[i-1]['single'])\n                ) {\n            htm = i;\n            val = i + \"-\";\n            i += 1;\n        } else {\n            htm = i + \"-\" + (i+1);\n            val = i + \"-\" + (i+1);\n            i += 2;\n            numThin += 2;\n        }\n        var option = $( '<option>', {\n            html: htm,\n            value: val\n        });\n        $(\"#mobile-two-page-select\").append(option);\n    }            \n    if (numThin / our_galleryinfo.length < 0.1) {\n        portrait = true;\n    }\n}\n\nfunction fullSpread() {\n        global_number_of_reader_buttons = 2;\n        \n        $(\"#fullSpread\").parent().hide();\n        $(\"#singlePage\").parent().show(); global_number_of_reader_buttons++;\n        $(\"#offsetPage\").parent().show(); global_number_of_reader_buttons++;\n\n\n        $(\"#single-page-select\").parent().addClass(\"hidden\");\n        $(\"#two-page-select\").parent().removeClass(\"hidden\");\n\n        $('#singlePage').show();\n        $('#offsetPage').show();\n        \n        vate_scene_buttons(false);\n        \n        updateDropdown(2);\n        \n        spread(2);\n        \n        Cookies.set(galleryinfo['type']+'-spread', 'full_spread', { secure: true, expires: 365*10 });\n}\n\nfunction mobile_fullSpread() {\n        global_number_of_reader_buttons = 2;\n        \n        $(\"#mobile-fullSpread\").parent().addClass(\"hidden\");\n        $(\"#mobile-singlePage\").parent().removeClass(\"hidden\"); global_number_of_reader_buttons++;\n        if (get_toolbar_remaining_space() > paging_dropdown_collapsed_width + 2*mobile_button_width) {\n                $(\"#mobile-offsetPage\").parent().removeClass(\"hidden\"); global_number_of_reader_buttons++;\n        }\n\n        $(\"#mobile-single-page-select\").parent().addClass(\"hidden\");\n        $(\"#mobile-two-page-select\").parent().removeClass(\"hidden\");\n        \n        vate_scene_buttons(false);\n\n        mobile_updateDropdown(2);\n        \n        mobile_spread(2);\n        \n        $(\"#mobileImages\").focusWithoutScrolling();\n}\n\nfunction vate_scene_buttons(on) {\n        if (is_mobile) {\n                if (on && get_toolbar_remaining_space() > paging_dropdown_collapsed_width + 3*mobile_button_width) {\n                        $(`#mobile-prevScene`).parent().removeClass('hidden'); global_number_of_reader_buttons++;\n                        $(`#mobile-nextScene`).parent().removeClass('hidden'); global_number_of_reader_buttons++;\n                } else {\n                        $(`#mobile-prevScene`).parent().addClass('hidden');\n                        $(`#mobile-nextScene`).parent().addClass('hidden');\n                }\n        } else {\n                if (on) {\n                        $(`#prevScene`).parent().show(); global_number_of_reader_buttons++;\n                        $(`#nextScene`).parent().show(); global_number_of_reader_buttons++;\n                        $(`#prevScene`).show();\n                        $(`#nextScene`).show();\n                } else {\n                        $(`#prevScene`).parent().hide();\n                        $(`#nextScene`).parent().hide();\n                        $(`#prevScene`).hide();\n                        $(`#nextScene`).hide();\n                }\n        }\n}\n\nfunction singleSpread() {\n        global_number_of_reader_buttons = 2;\n        \n        $(\"#singlePage\").parent().hide();\n        $(\"#offsetPage\").parent().hide();\n        $(\"#fullSpread\").parent().show(); global_number_of_reader_buttons++;\n\n        $(\"#two-page-select\").parent().addClass(\"hidden\");\n        $(\"#single-page-select\").parent().removeClass(\"hidden\");\n\n        $('#fullSpread').show();\n        $('#offsetPage').hide();\n        \n        vate_scene_buttons(galleryinfo['type'] === 'gamecg');\n\n        updateDropdown(1);\n\n        spread(1);\n        \n        vate($('#prevScene'), !at_first_scene());\n        vate($('#nextScene'), !at_last_scene());\n\n        Cookies.set(galleryinfo['type']+'-spread', 'single_page', { secure: true, expires: 365*10 });\n}\n\nfunction mobile_singleSpread() {\n        global_number_of_reader_buttons = 2;\n        \n        $(\"#mobile-singlePage\").parent().addClass('hidden');\n        $(\"#mobile-offsetPage\").parent().addClass('hidden');\n        $(\"#mobile-fullSpread\").parent().removeClass('hidden'); global_number_of_reader_buttons++;\n        \n        $(\"#mobile-two-page-select\").parent().addClass(\"hidden\");\n        $(\"#mobile-single-page-select\").parent().removeClass(\"hidden\");\n        \n        vate_scene_buttons(false);\n        vate_scene_buttons(galleryinfo['type'] === 'gamecg');\n\n        mobile_updateDropdown(1);\n        \n        mobile_spread(1);\n        \n        mobile_vate($('#mobile-prevScene'), !at_first_scene());\n        mobile_vate($('#mobile-nextScene'), !at_last_scene());\n\n        $(\"#mobileImages\").focusWithoutScrolling();\n}\n\nfunction updateDropdown(num) {\n    switch (num) {\n        case 1:\n            $(\"#single-page-select option:selected\").prop(\"selected\", false);\n            $(\"#single-page-select option\").each(function() {\n                if ($(this).val() == curPanel) {\n                    \n                    $(this).prop(\"selected\", true);\n                    \n                    history.replaceState(undefined, undefined, '#'+curPanel);\n                    $(this).parent().trigger(\"change\");\n                }\n            });\n            break;\n        case 2:\n            var re = /^(\\d+)-(\\d*)$/;\n            $(\"#two-page-select option:selected\").prop(\"selected\", false);\n            $(\"#two-page-select option\").each(function() {\n                var ok = re.exec($(this).val());\n                if (ok[1] == curPanel || ok[2] == curPanel) {\n                    \n                    $(this).prop(\"selected\", true);\n                    \n                    history.replaceState(undefined, undefined, '#'+ok[0]);\n                    $(this).parent().trigger(\"change\");\n                }\n            });\n            break;\n    }\n}\n\nfunction get_toolbar_remaining_space() {\n        var remaining_space = $(window).width() - (160 + mobile_button_width*global_number_of_reader_buttons);\n        if (remaining_space < paging_dropdown_collapse_threshold) {\n                remaining_space = paging_dropdown_collapsed_width;\n        }\n        return remaining_space;\n}\n\nfunction get_single_page_dropdown_width() {\n        return ($(\"#mobile-single-page-select\").val().length * 9) + 40 - 19;\n}\n\nfunction get_two_page_dropdown_width() {\n        const dash_space = $(\"#mobile-two-page-select\").val().slice(-1) === \"-\" ? 28 : 23;\n        return ($(\"#mobile-two-page-select\").val().length * 9) + 40 - dash_space;\n}\n\nfunction set_single_page_dropdown_width() {\n        $(\"#mobile-single-page-select\").width(Math.min(get_single_page_dropdown_width(), get_toolbar_remaining_space()));\n}\n\nfunction set_two_page_dropdown_width() {\n        $(\"#mobile-two-page-select\").width(Math.min(get_two_page_dropdown_width(), get_toolbar_remaining_space()));\n}\n\nfunction mobile_updateDropdown(num) {\n    switch (num) {\n        case 1:\n            $(\"#mobile-single-page-select option:selected\").prop(\"selected\", false);\n            $(\"#mobile-single-page-select option\").each(function() {\n                if ($(this).val() == curPanel) {\n                    \n                    $(this).prop(\"selected\", true);\n                    \n                    set_single_page_dropdown_width();\n                    \n                    history.replaceState(undefined, undefined, '#'+curPanel);\n                    $(this).parent().trigger(\"change\");\n                }\n            });\n            break;\n        case 2:\n            var re = /^(\\d+)-(\\d*)$/;\n            $(\"#mobile-two-page-select option:selected\").prop(\"selected\", false);\n            $(\"#mobile-two-page-select option\").each(function() {\n                var ok = re.exec($(this).val());\n                if (ok[1] == curPanel || ok[2] == curPanel) {\n                    \n                    $(this).prop(\"selected\", true);\n                    \n                    set_two_page_dropdown_width();\n                    \n                    history.replaceState(undefined, undefined, '#'+ok[0]);\n                    $(this).parent().trigger(\"change\");\n                }\n            });\n            break;\n    }\n}\n\nfunction spread(num) {\n        $('body').removeClass('spread'+display);\n        display = num;\n        $('body').addClass('spread'+display);\n\n        if (display == 2) {\n                var found = false;\n                var pattern = curPanel + \"-\";\n                $(\"#two-page-select option\").each(function() {\n                        if ($(this).val().search(pattern) > -1) {\n                            