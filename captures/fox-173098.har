          "content": {
            "size": 21316,
            "mimeType": "application/x-javascript",
            "text": "(function () {\n    'use strict';\n\n    function normalize(value) {\n        return String(value || '')\n            .toLocaleLowerCase()\n            .replace(/[^a-z0-9]+/gi, '');\n    }\n\n    function getContextValue(input, selectorAttribute, valueAttribute) {\n        var directValue = input.getAttribute(valueAttribute);\n        if (directValue) {\n            return directValue;\n        }\n\n        var selector = input.getAttribute(selectorAttribute);\n        if (!selector) {\n            return '';\n        }\n\n        var field = document.querySelector(selector);\n        return field ? field.value : '';\n    }\n\n    function evaluate(input) {\n        var password = input.value || '';\n        var length = password.length;\n        var username = normalize(getContextValue(\n            input,\n            'data-username-selector',\n            'data-username-value'\n        ));\n        var email = getContextValue(\n            input,\n            'data-email-selector',\n            'data-email-value'\n        );\n        var emailLocal = normalize(String(email).split('@')[0]);\n        var normalizedPassword = normalize(password);\n\n        var containsContext =\n            (username.length >= 4 && normalizedPassword.indexOf(username) !== -1) ||\n            (emailLocal.length >= 4 && normalizedPassword.indexOf(emailLocal) !== -1) ||\n            normalizedPassword.indexOf('hentaifox') !== -1;\n\n        var score = 0;\n        if (length >= 15) { score += 2; }\n        if (length >= 20) { score += 1; }\n        if (length >= 28) { score += 1; }\n        if (/\\s/.test(password) || /[^A-Za-z0-9]/.test(password)) { score += 1; }\n        if (containsContext) { score = Math.min(score, 1); }\n\n        var valid = length >= 15 && length <= 64 && !containsContext;\n        var message;\n        if (!password) {\n            message = 'Use at least 15 characters.';\n        } else if (length < 15) {\n            message = 'Too short — use at least 15 characters.';\n        } else if (length > 64) {\n            message = 'Password is too long. Please use a shorter password.';\n        } else if (containsContext) {\n            message = 'Do not include your username, email name, or the site name.';\n        } else if (score >= 4) {\n            message = 'Strong password.';\n        } else {\n            message = 'Accepted. A longer unique passphrase would be stronger.';\n        }\n\n        return {\n            valid: valid,\n            score: Math.max(0, Math.min(4, score)),\n            message: message\n        };\n    }\n\n    function attachIndicator(input) {\n        if (input.getAttribute('data-password-indicator-ready') === '1') {\n            return;\n        }\n        input.setAttribute('data-password-indicator-ready', '1');\n\n        var wrapper = document.createElement('div');\n        wrapper.className = 'password-policy-indicator';\n        wrapper.setAttribute('aria-live', 'polite');\n\n        var bar = document.createElement('span');\n        bar.className = 'password-policy-bar';\n\n        var text = document.createElement('small');\n        text.className = 'password-policy-text';\n\n        wrapper.appendChild(bar);\n        wrapper.appendChild(text);\n        input.insertAdjacentElement('afterend', wrapper);\n\n        function render() {\n            var result = evaluate(input);\n            bar.style.width = (result.score * 25) + '%';\n            bar.style.backgroundColor = result.valid\n                ? (result.score >= 4 ? '#2ea44f' : '#d29922')\n                : '#b34141';\n            text.textContent = result.message;\n            wrapper.setAttribute('data-valid', result.valid ? '1' : '0');\n            wrapper.setAttribute(\n                'data-strength',\n                result.valid && result.score >= 4 ? 'strong' : 'standard'\n            );\n        }\n\n        input.addEventListener('input', render);\n        var usernameSelector = input.getAttribute('data-username-selector');\n        var emailSelector = input.getAttribute('data-email-selector');\n        [usernameSelector, emailSelector].forEach(function (selector) {\n            if (!selector) { return; }\n            var contextField = document.querySelector(selector);\n            if (contextField) {\n                contextField.addEventListener('input', render);\n            }\n        });\n        render();\n    }\n\n    function attachConfirmationIndicator(input) {\n        if (input.getAttribute('data-password-confirmation-ready') === '1') {\n            return;\n        }\n\n        var passwordSelector = input.getAttribute('data-password-confirm-for');\n        var passwordInput = passwordSelector\n            ? document.querySelector(passwordSelector)\n            : null;\n        if (!passwordInput) {\n            return;\n        }\n\n        input.setAttribute('data-password-confirmation-ready', '1');\n\n        var wrapper = document.createElement('div');\n        wrapper.className = 'password-confirmation-indicator';\n        wrapper.setAttribute('aria-live', 'polite');\n\n        var text = document.createElement('small');\n        text.className = 'password-confirmation-text';\n        wrapper.appendChild(text);\n        input.insertAdjacentElement('afterend', wrapper);\n\n        function render() {\n            var confirmation = input.value || '';\n            var password = passwordInput.value || '';\n\n            if (!confirmation) {\n                input.setCustomValidity('');\n                text.textContent = 'Repeat the password exactly.';\n                wrapper.removeAttribute('data-valid');\n                return;\n            }\n\n            if (confirmation === password) {\n                input.setCustomValidity('');\n                text.textContent = 'Passwords match.';\n                wrapper.setAttribute('data-valid', '1');\n                return;\n            }\n\n            input.setCustomValidity('Passwords do not match.');\n            text.textContent = 'Passwords do not match.';\n            wrapper.setAttribute('data-valid', '0');\n        }\n\n        input.addEventListener('input', render);\n        passwordInput.addEventListener('input', render);\n        render();\n    }\n\n    var emailDomainCorrections = {\n        'gamil.com': 'gmail.com',\n        'gmail.con': 'gmail.com',\n        'gmai.com': 'gmail.com',\n        'gnail.com': 'gmail.com',\n        'gmail.co': 'gmail.com',\n        'gmil.com': 'gmail.com',\n        'gmailcom': 'gmail.com',\n        'gmal.com': 'gmail.com',\n        'gmial.com': 'gmail.com',\n        'gamail.com': 'gmail.com',\n        'gmail.cim': 'gmail.com',\n        'gmsil.com': 'gmail.com',\n        'gmali.com': 'gmail.com',\n        'gmaill.com': 'gmail.com',\n        'gmail.vom': 'gmail.com',\n        'gmail.xom': 'gmail.com',\n        'gmail.clm': 'gmail.com',\n        'gmail.om': 'gmail.com',\n        'gmail.cm': 'gmail.com',\n        'gmail.cmo': 'gmail.com',\n        'yahoo.con': 'yahoo.com',\n        'yahoo.xom': 'yahoo.com',\n        'yaho.com': 'yahoo.com',\n        'yahoo.co': 'yahoo.com',\n        'yahooo.com': 'yahoo.com',\n        'yaoo.com': 'yahoo.com',\n        'hotmai.com': 'hotmail.com',\n        'hotmail.con': 'hotmail.com',\n        'hotmail.xom': 'hotmail.com',\n        'hotmial.com': 'hotmail.com',\n        'hotmail.co': 'hotmail.com',\n        'hotmal.com': 'hotmail.com',\n        'outlook.con': 'outlook.com',\n        'outlook.xom': 'outlook.com',\n        'outloo.com': 'outlook.com',\n        'outlook.co': 'outlook.com',\n        'outlok.com': 'outlook.com',\n        'icloud.con': 'icloud.com',\n        'icloud.xom': 'icloud.com',\n        'icloud.co': 'icloud.com'\n    };\n\n    var strictCanonicalEmailProviders = {\n        gmail: 'gmail.com',\n        icloud: 'icloud.com'\n    };\n\n    function attachEmailTypoIndicator(input) {\n        if (input.getAttribute('data-email-typo-ready') === '1') {\n            return;\n        }\n        input.setAttribute('data-email-typo-ready', '1');\n\n        var wrapper = document.createElement('div');\n        wrapper.className = 'email-typo-indicator';\n        wrapper.setAttribute('aria-live', 'polite');\n\n        var text = document.createElement('small');\n        text.className = 'email-typo-text';\n        wrapper.appendChild(text);\n        input.insertAdjacentElement('afterend', wrapper);\n\n        function render() {\n            var email = String(input.value || '').trim();\n            var separator = email.lastIndexOf('@');\n            var localPart = separator >= 0\n                ? email.substring(0, separator)\n                : '';\n            var domain = separator >= 0\n                ? email.substring(separator + 1).toLowerCase()\n                : '';\n            var correctedDomain = emailDomainCorrections[domain];\n            if (!correctedDomain && domain.indexOf('.') > 0) {\n                var providerLabel = domain.split('.', 1)[0];\n                var canonicalDomain =\n                    strictCanonicalEmailProviders[providerLabel];\n                if (canonicalDomain && domain !== canonicalDomain) {\n                    correctedDomain = canonicalDomain;\n                }\n            }\n\n            if (!localPart || !correctedDomain) {\n                input.setCustomValidity('');\n                text.textContent = '';\n                wrapper.removeAttribute('data-invalid');\n                return;\n            }\n\n            var suggestion = localPart + '@' + correctedDomain;\n            input.setCustomValidity(\n                'Did you mean ' + suggestion + '?'\n            );\n            text.textContent =\n                'Did you mean ' + suggestion +\n                '? Please correct the address.';\n            wrapper.setAttribute('data-invalid', '1');\n        }\n\n        input.addEventListener('input', render);\n        input.addEventListener('blur', render);\n        render();\n    }\n\n    function notify(message, success) {\n        if (window.jQuery && jQuery.notiny) {\n            jQuery.notiny({\n                text: \"<i class='fa fa-\" +\n                    (success ? \"check\" : \"exclamation-triangle\") +\n                    \"'></i> \" + message,\n                theme: success ? 'hf-success' : 'hf-error',\n                width: 'auto'\n            });\n            return;\n        }\n        window.alert(message.replace(/<[^>]+>/g, ''));\n    }\n\n    var policyErrors = {\n        pass_policy_too_short: 'Your new password must contain at least 15 characters.',\n        pass_policy_too_long: 'Password is too long. Please use a shorter password.',\n        pass_policy_reused: 'Your new password must be different from your current password.',\n        pass_policy_contains_account_data: 'Do not include your username, email name, or the site name.',\n        pass_policy_common: 'This password is too common. Please choose a unique password.',\n        pass_policy_compromised: 'This password is known to be commonly used or compromised.'\n    };\n\n    /*\n     * The legacy bundle also handles this button. Capture the click first so\n     * the stronger policy receives accurate response messages.\n     */\n    document.addEventListener('click', function (event) {\n        var button = event.target.closest ? event.target.closest('#save_password') : null;\n        if (!button) {\n            return;\n        }\n\n        event.preventDefault();\n        event.stopPropagation();\n        event.stopImmediatePropagation();\n\n        if (button.disabled) {\n            return;\n        }\n\n        var oldPassword = document.getElementById('old_password');\n        var newPassword = document.getElementById('new_password');\n        var confirmation = document.getElementById('c_new_password');\n        if (!oldPassword || !newPassword || !confirmation) {\n            notify('All password fields are required.', false);\n            return;\n        }\n\n        var policy = evaluate(newPassword);\n        if (!oldPassword.value || !newPassword.value || !confirmation.value) {\n            notify('All password fields are required.', false);\n            return;\n        }\n        if (!policy.valid) {\n            notify(policy.message, false);\n            return;\n        }\n        if (newPassword.value !== confirmation.value) {\n            notify('New passwords do not match.', false);\n            return;\n        }\n        if (oldPassword.value === newPassword.value) {\n            notify('Your new password must be different from your current password.', false);\n            return;\n        }\n\n        button.disabled = true;\n        jQuery.ajax({\n            url: '/includes/edit_profile.php',\n            type: 'POST',\n            data: {\n                act: 'pass',\n                old_password: oldPassword.value,\n                new_password: newPassword.value,\n                c_new_password: confirmation.value\n            },\n            success: function (response) {\n                var result = String(response).trim().toLowerCase();\n                if (result === 'success') {\n                    oldPassword.value = '';\n                    newPassword.value = '';\n                    confirmation.value = '';\n                    notify('Your password was changed. You will be redirected to login again.', true);\n                    window.setTimeout(function () {\n                        window.location.href = '/logout/';\n                    }, 2500);\n                    return;\n                }\n\n                if (result === 'wrong_pass') {\n                    notify('Your current password is incorrect.', false);\n                } else if (result === 'review_email_required') {\n                    notify(\n                        'Please verify your email and use the password reset link sent to it.',\n                        false\n                    );\n                } else if (result === 'pass_mismatch') {\n                    notify('New passwords do not match.', false);\n                } else if (policyErrors[result]) {\n                    notify(policyErrors[result], false);\n                } else if (result === 'not_logged') {\n                    notify('Your session expired. Please log in again.', false);\n                } else {\n                    notify('The password could not be changed. Please refresh and try again.', false);\n                }\n                button.disabled = false;\n            },\n            error: function () {\n                notify('The password could not be changed. Please refresh and try again.', false);\n                button.disabled = false;\n            }\n        });\n    }, true);\n\n    document.addEventListener('click', function (event) {\n        var button = event.target.closest\n            ? event.target.closest('#send_security_review_reset')\n            : null;\n        if (!button) {\n            return;\n        }\n\n        event.preventDefault();\n        event.stopPropagation();\n        event.stopImmediatePropagation();\n\n        if (button.disabled) {\n            return;\n        }\n\n        var email = document.getElementById('security_review_email');\n        var currentPassword = document.getElementById(\n            'security_review_password'\n        );\n        if (!email || !currentPassword) {\n            notify('Please refresh the page and try again.', false);\n            return;\n        }\n\n        email.value = String(email.value || '').trim();\n        if (!email.value || !email.checkValidity()) {\n            email.reportValidity();\n            notify('Please enter a valid long-term email address.', false);\n            return;\n        }\n        if (!currentPassword.value) {\n            notify(\n                'Confirm your current password to continue.',\n                false\n            );\n            return;\n     