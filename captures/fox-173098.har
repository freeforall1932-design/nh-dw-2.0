            "mimeType": "application/x-javascript",
            "text": "$(document).on(\"click\", \".close_report_modal\", function() {\r\n    $(this).closest(\"#report_modal\").hide();\r\n});\r\n\r\n$(document).on(\"click\", \"#report_modal\", function(e) {\r\n    if (e.target === this) {\r\n        $(this).hide();\r\n    }\r\n});\r\n\r\n$(document).on(\"click\", \"#report_btn\", function(e) {\r\n    e.preventDefault();\r\n\r\n    $.ajax({\r\n        url: '/includes/add_report.php',\r\n        type: 'POST',\r\n        data: {\r\n            action: 'check',\r\n            gallery_id: $(\"#gallery_id\").val()\r\n        },\r\n        success: function(response) {\r\n            if(response == 'not_logged') {\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> You must be logged in to report this gallery.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n            else if(response == 'already') {\r\n                $.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> You already reported this gallery.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n            else if(response == 'ok') {\r\n                $(\"#report_modal\").show();\r\n            }\r\n            else {\r\n                $.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> There was a problem reporting this gallery, please refresh page and try again.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n        },\r\n        error: function() {\r\n            $.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> There was a problem reporting this gallery, please refresh page and try again.\",theme:\"hf-error\",width:\"auto\"});\r\n        }\r\n    });\r\n\r\n    return false;\r\n});\r\n\r\n$(document).on(\"click\", \"#submit_report_btn\", function(e) {\r\n    e.preventDefault();\r\n\r\n    $.ajax({\r\n        url: '/includes/add_report.php',\r\n        type: 'POST',\r\n        data: {\r\n            action: 'submit',\r\n            gallery_id: $(\"#gallery_id\").val(),\r\n            description: $(\"#report_description\").val()\r\n        },\r\n        success: function(response) {\r\n            if(response == 'not_logged') {\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> You must be logged in to report this gallery.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n            else if(response == 'already') {\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> You already reported this gallery.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n            else if(response == 'empty_description') {\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> Type the reason for reporting this gallery.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n            else if(response == 'success') {\r\n                $(\"#report_description\").val('');\r\n                $(\"#report_modal\").hide();\r\n                $(\"#report_btn\").prop('disabled', true);\r\n\t\t\t\t\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-check'></i> You reported this gallery successfully!\",theme:\"hf-success\",width:\"auto\"});\r\n            }\r\n            else {\r\n\t\t\t\t$.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> There was a problem reporting this gallery, please refresh page and try again.\",theme:\"hf-error\",width:\"auto\"});\r\n            }\r\n        },\r\n        error: function() {\r\n            $.notiny({text:\"<i class='fa fa-exclamation-triangle'></i> There was a problem reporting this gallery, please refresh page and try again.\",theme:\"hf-error\",width:\"auto\"});\r\n        }\r\n    });\r\n\r\n    return false;\r\n});"
