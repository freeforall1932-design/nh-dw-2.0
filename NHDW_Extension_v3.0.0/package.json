{
  "name": "nhentaidownloader",
  "version": "2.2.0",
  "description": "A chrome extension to download doujinshi from NHentai ",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "webpack",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && mocha test/test.js test/parsing.test.js test/downloader.test.js --timeout 15000",
    "test:smoke": "node scripts/smoke-mv3.js && node scripts/smoke-mv3.js js/offscreen.js --offscreen",
    "test:e2e": "node scripts/e2e-worker.js && node scripts/e2e-offscreen.js && node scripts/e2e-relay.js && node scripts/e2e-content.js",
    "test:live": "RUN_LIVE_TESTS=1 mocha test/test.js --timeout 30000",
    "test:browser": "node scripts/e2e-browser.js --extension ../NHDW_Release_v3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xwilarg/NHentaiDownloader.git"
  },
  "keywords": [
    "chrome-extension",
    "downloader",
    "firefox-addon",
    "nhentai",
    "hentai",
    "doujinshi"
  ],
  "author": "Xwilarg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Xwilarg/NHentaiDownloader/issues"
  },
  "homepage": "https://github.com/Xwilarg/NHentaiDownloader#readme",
  "devDependencies": {
    "@types/chrome": "0.0.154",
    "mocha": "^11.0.1",
    "node-fetch": "^2.6.1",
    "ts-loader": "^9.2.5",
    "typescript": "^4.4.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.8.0"
  },
  "dependencies": {
    "file-saver": "2.0.5",
    "jszip": "3.9.1"
  }
}
