{
  "name": "NHentai Downloader",
  "version": "3.11.5",
  "description": "A chrome extension to download doujinshi from NHentai - Updated for Manifest V3",
  "icons": {
    "64": "Icon.png",
    "128": "Icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "64": "Icon.png",
      "128": "Icon.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "offscreen",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*.nhentai.net/*"
  ],
  "host_permissions": [
    "https://nhentai.net/*",
    "https://i.nhentai.net/*",
    "https://i1.nhentai.net/*",
    "https://i2.nhentai.net/*",
    "https://i3.nhentai.net/*",
    "https://i4.nhentai.net/*",
    "https://hentaiera.com/*",
    "https://*.hentaiera.com/*",
    "https://hentaiera.to/*",
    "https://*.hentaiera.to/*",
    "https://hentaiera.site/*",
    "https://*.hentaiera.site/*",
    "https://imhentai.xxx/*",
    "https://*.imhentai.xxx/*",
    "https://imhentai.org/*",
    "https://*.imhentai.org/*",
    "https://imhentai.net/*",
    "https://*.imhentai.net/*",
    "https://hentaienvy.com/*",
    "https://*.hentaienvy.com/*",
    "https://hentaifox.com/*",
    "https://*.hentaifox.com/*",
    "https://hitomi.la/*",
    "https://*.hitomi.la/*",
    "https://*.gold-usergeneratedcontent.net/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://nhentai.net/*"
      ],
      "css": [
        "css/content.css"
      ],
      "js": [
        "js/content.js",
        "js/listControls.js"
      ]
    },
    {
      "matches": [
        "https://hentaiera.com/*",
        "https://*.hentaiera.com/*",
        "https://hentaiera.to/*",
        "https://*.hentaiera.to/*",
        "https://imhentai.xxx/*",
        "https://*.imhentai.xxx/*",
        "https://imhentai.org/*",
        "https://*.imhentai.org/*",
        "https://imhentai.net/*",
        "https://*.imhentai.net/*",
        "https://hentaienvy.com/*",
        "https://*.hentaienvy.com/*",
        "https://hentaifox.com/*",
        "https://*.hentaifox.com/*",
        "https://hitomi.la/*",
        "https://*.hitomi.la/*"
      ],
      "css": [
        "css/content.css"
      ],
      "js": [
        "js/content.js",
        "js/listControls.js"
      ]
    },
    {
      "matches": [
        "https://nhentai.net/g/*",
        "https://hentaiera.com/*",
        "https://*.hentaiera.com/*",
        "https://hentaiera.to/*",
        "https://*.hentaiera.to/*",
        "https://hentaiera.site/*",
        "https://*.hentaiera.site/*",
        "https://imhentai.xxx/*",
        "https://*.imhentai.xxx/*",
        "https://imhentai.org/*",
        "https://*.imhentai.org/*",
        "https://imhentai.net/*",
        "https://*.imhentai.net/*",
        "https://hentaienvy.com/*",
        "https://*.hentaienvy.com/*",
        "https://hentaifox.com/*",
        "https://*.hentaifox.com/*",
        "https://hitomi.la/*",
        "https://*.hitomi.la/*"
      ],
      "css": [
        "css/titleBookmark.css"
      ],
      "js": [
        "js/titleBookmark.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Icon.png",
        "Icon-grey.png"
      ],
      "matches": [
        "https://nhentai.net/*"
      ]
    }
  ],
  "manifest_version": 3
}
